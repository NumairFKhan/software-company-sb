# ============================================================
# CourtSide — environment variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- Supabase ----
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ---- App ----
# Public base URL used for Stripe Connect return/refresh URLs.
# In development this is http://localhost:3000 (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe ----
# Found in: Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret for /api/webhooks/stripe  (unified webhook — checkout.session.completed)
# and /api/coaches/stripe-webhook (coach onboarding — account.updated).
# Register each URL as a separate Stripe webhook endpoint with its own signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
# Legacy: webhook secret for /api/bookings/webhook (superseded by /api/webhooks/stripe)
STRIPE_BOOKING_WEBHOOK_SECRET=whsec_...

# ---- Resend (transactional email) ----
# Found in: Resend Dashboard → API Keys
RESEND_API_KEY=re_...
# "From" address for transactional emails (must be a verified Resend sender domain)
RESEND_FROM_EMAIL=CourtSide <noreply@courtside.app>

# ---- Cron ----
# Secret used to authenticate Vercel Cron calls to /api/cron/daily.
# Set the same value in the Vercel Dashboard under Project → Settings → Environment Variables.
# Vercel will pass it automatically as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=your-random-cron-secret-here
